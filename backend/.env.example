# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://root:root@localhost:5433/hackthon31-db?schema=public"

# Backend Server Port
PORT=3000

# Node Environment
NODE_ENV="development"

# JWT Secrets for Authentication
JWT_ACCESS_SECRET="lifeline_jwt_access_super_secret_key_2026"
JWT_REFRESH_SECRET="lifeline_jwt_refresh_super_secret_key_2026"

# Google Gemini API Key for Pretrained LLM Emergency Triage
# (If missing, invalid, or timing out > 3s, system falls back to offline deterministic rule engine)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model name for triage (e.g. gemini-2.5-flash or gemini-1.5-flash)
TRIAGE_MODEL="gemini-2.5-flash"

